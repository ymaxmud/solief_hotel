# Solief Hotel — environment configuration.
#
# Copy to `.env.local` for local development. `.env.local` is gitignored and must
# never be committed. This file contains variable NAMES and safe defaults only —
# never a real key.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle. Everything else is
# server-only and must never be referenced from a client component.

# --- Site -------------------------------------------------------------------
# REQUIRED. The public origin, with no trailing slash. Drives the canonical URL,
# sitemap, robots, OpenGraph, booking-notification links and staff QR links.
# Moving to the custom domain is a change to this value only — no code change.
#   current:  https://soliefhotel.vercel.app
#   future:   https://soliefhotel.com
NEXT_PUBLIC_SITE_URL=https://soliefhotel.vercel.app
#
# Optional server-only override, read at request time. NEXT_PUBLIC_SITE_URL is
# inlined at build time, so set SITE_URL to the same value if you need
# server-rendered links (robots, sitemap, canonical, emails, staff QR codes) to
# follow a domain change before the next build.
# SITE_URL=

# --- Supabase ---------------------------------------------------------------
# REQUIRED. Project URL (public).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# REQUIRED. Publishable key — browser-safe, protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# REQUIRED. Secret key — SERVER ONLY. Bypasses RLS. Never expose to the browser,
# never log it, never commit it.
SUPABASE_SECRET_KEY=sb_secret_xxx
#
# Legacy names. Still accepted as a fallback during key rotation; remove them
# once every deployment target uses the names above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Booking notifications (server only) ------------------------------------
# REQUIRED for the hotel to be notified. Comma-separated; duplicates are removed
# server-side, and one email is sent to all recipients.
BOOKING_EMAIL_TO=hsolief@gmail.com,fayzullayevquvonch00@gmail.com
# Optional extra recipients, merged with BOOKING_EMAIL_TO.
BOOKING_EMAIL_CC=
HOTEL_OWNER_EMAIL=
#
# SMTP transport (preferred — no third party). For Gmail, create a Google App
# Password: Account > Security > 2-Step Verification > App passwords. Never use
# the normal account password.
SMTP_USER=hsolief@gmail.com
SMTP_PASS=
# Default to Gmail when unset.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Defaults to SMTP_USER when unset.
BOOKING_EMAIL_FROM=
#
# Optional alternative transport, used only when SMTP is not configured.
RESEND_API_KEY=

# --- Owner contact ----------------------------------------------------------
# Optional. Digits only, E.164 without "+". When set, the booking API returns a
# prefilled wa.me link for staff follow-up.
HOTEL_OWNER_WHATSAPP_E164=998983624949

# --- Cloudflare Turnstile (optional anti-spam) ------------------------------
# When both are set, the booking form renders the widget and the server verifies
# the token. When unset, the form still works and the database-backed rate limits
# remain the protection. Rate limiting is never disabled by Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Staff attendance geofence (public) -------------------------------------
NEXT_PUBLIC_HOTEL_LAT=41.2683062
NEXT_PUBLIC_HOTEL_LNG=69.2038021
NEXT_PUBLIC_ATTENDANCE_RADIUS_METERS=150

# --- One-time admin bootstrap (server only) ---------------------------------
# Used by `npm run create-initial-admin` when no administrator exists yet.
# Set ALLOW_INITIAL_ADMIN_BOOTSTRAP back to false immediately afterwards, and
# change the password on first login.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
ALLOW_INITIAL_ADMIN_BOOTSTRAP=false

# --- Observability ----------------------------------------------------------
# Vercel Analytics and Speed Insights need no key on Vercel. Sentry is optional
# and stays off unless a DSN is set — see OBSERVABILITY_NOTES.md.
NEXT_PUBLIC_SENTRY_DSN=
